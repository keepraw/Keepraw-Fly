{
  "name": "keepraw-fly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @keepraw-fly/web dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @keepraw-fly/web preview",
    "update:airports": "node scripts/update-airports.mjs",
    "update:airlines": "node scripts/update-airlines.mjs",
    "update:airline-icons": "node scripts/generate-airline-icons.mjs",
    "update:airport-locales": "node scripts/update-airport-locales.mjs",
    "update:zh-tw": "node scripts/update-zh-tw-locale.mjs",
    "update:world-map": "node scripts/update-world-map.mjs",
    "check:docs": "node scripts/check-doc-consistency.mjs",
    "test": "node --test scripts/css-tokens.test.mjs && pnpm -r test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,css,json,md,yaml,yml}\"",
    "lint:css": "stylelint \"apps/web/src/design-system.css\" \"apps/web/src/styles/*.css\"",
    "check:css-tokens": "node scripts/check-css-tokens.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "d3-geo": "3.1.1",
    "opencc-js": "1.4.2",
    "postcss": "8.5.28",
    "postcss-value-parser": "^4.2.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
