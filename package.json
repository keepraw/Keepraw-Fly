{
  "name": "keepraw-fly",
  "version": "0.1.1",
  "author": "keepraw",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @keepraw-fly/web dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @keepraw-fly/web preview",
    "update:airports": "node scripts/update-airports.mjs",
    "update:airlines": "node scripts/update-airlines.mjs",
    "update:airline-icons": "node scripts/generate-airline-icons.mjs",
    "update:airport-locales": "node scripts/update-airport-locales.mjs",
    "update:zh-tw": "node scripts/update-zh-tw-locale.mjs",
    "update:world-map": "node scripts/update-world-map.mjs",
    "check:docs": "node scripts/check-doc-consistency.mjs",
    "test": "node --test scripts/css-tokens.test.mjs scripts/ci-validation.test.mjs scripts/update-zh-tw-locale.test.mjs && bash scripts/test-release-version.sh && bash scripts/test-release-source.sh && bash scripts/test-release-provenance.sh && bash scripts/test-installer-provenance.sh && pnpm -r test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "check:i18n": "pnpm --filter @keepraw-fly/web exec vitest run src/i18n-resources.test.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,css,json,md,yaml,yml}\"",
    "lint:css": "stylelint \"apps/web/src/design-system.css\" \"apps/web/src/styles/*.css\" \"apps/web/src/globe/detail-globe.css\"",
    "check:css-tokens": "node scripts/check-css-tokens.mjs",
    "test:e2e:csp": "playwright test --config playwright.csp.config.ts",
    "check:security-headers": "node scripts/check-security-headers.mjs",
    "check:webfont-sri": "node scripts/verify-webfont-sri.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.3.0",
    "d3-geo": "3.1.1",
    "opencc-js": "1.4.2",
    "postcss": "8.5.30",
    "postcss-value-parser": "^4.2.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  }
}
